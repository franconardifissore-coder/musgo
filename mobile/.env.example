# Copia este archivo a `.env` y completa con los valores reales del proyecto.
# Las EXPO_PUBLIC_* son leídas por Expo en build time y expuestas en cliente.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Solo necesario para `npm run gen:supabase-types`.
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
